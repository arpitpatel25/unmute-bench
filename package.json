{
  "name": "unmute-bench",
  "version": "0.1.0",
  "description": "The benchmark that measures the human, not the model. Scores how much work you hand to Claude Code and Codex, from your own local logs.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=unmute-bench.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "benchmark",
    "productivity"
  ],
  "license": "MIT",
  "homepage": "https://justunmute.me/bench",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0"
  },
  "private": true
}
